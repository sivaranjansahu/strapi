{
  "kind": "collectionType",
  "collectionName": "top-10s",
  "info": {
    "singularName": "top-10",
    "pluralName": "top-10s",
    "displayName": "top-10",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "Published": {
      "type": "boolean"
    },
    "heading": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "directoryniche": {
      "type": "string",
      "required": true
    },
    "excerpt": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "Title"
    },
    "reading_time": {
      "type": "integer"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "structured_data": {
      "type": "json"
    },
    "seo": {
      "type": "json"
    },
    "heroimage": {
      "type": "json"
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::category.category"
    },
    "directory": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::directory.directory"
    },
    "Business": {
      "displayName": "businessDetails",
      "type": "component",
      "repeatable": true,
      "component": "business.business-details"
    }
  }
}
